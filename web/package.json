{
  "name": "exchange-lab-web",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "biome lint src vite.config.ts playwright.config.ts",
    "lint:fix": "biome lint --write src vite.config.ts playwright.config.ts",
    "prepare": "cd .. && husky web/.husky",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "klinecharts": "10.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
