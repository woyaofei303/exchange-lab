# 在 Linux 主机上复制为 .env.prod，切勿提交生成的文件。
IMAGE_REPOSITORY=ghcr.io/woyaofei303/exchange-lab
IMAGE_TAG=replace-with-commit-sha
EXCHANGE_DOMAIN=exchange.example.com
ACME_EMAIL=ops@example.com
POSTGRES_DB=exchange
POSTGRES_USER=exchange
POSTGRES_DSN_SECRET_FILE=./secrets/postgres_dsn
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password
OPENAI_API_KEY_SECRET_FILE=./secrets/openai_api_key
OPENAI_MODEL=gpt-5-mini
AUTH_COOKIE_SECURE=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=10m
