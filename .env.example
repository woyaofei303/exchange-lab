APP_HTTP_ADDR=:8080
POSTGRES_DB=exchange
POSTGRES_USER=exchange
POSTGRES_PASSWORD=exchange_dev_only
POSTGRES_HOST_PORT=5432
# POSTGRES_DSN is canonical for the API. Keep its user/database/password aligned
# with the raw container values above; percent-encode reserved password characters.
POSTGRES_DSN=postgres://exchange:exchange_dev_only@postgres:5432/exchange?sslmode=disable
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONNS=10
DATABASE_TIMEOUT=2s
REDIS_ADDR=redis:6379
REDIS_HOST_PORT=6379
CACHE_TIMEOUT=200ms
INSTRUMENT_CACHE_TTL=5m
TICKER_CACHE_TTL=5s
NATS_URL=nats://nats:4222
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
DEPENDENCY_TIMEOUT=1s
REQUEST_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
AUTH_SESSION_TTL=24h
AUTH_COOKIE_SECURE=false
API_HOST_PORT=8080
WEB_HOST_PORT=3000
SIMULATOR_HOST_PORT=8090
CANDLE_HOST_PORT=8091
EVENT_HOST_PORT=8092
PRICE_HOST_PORT=8093
RISK_HOST_PORT=8094
FUNDING_HOST_PORT=8095
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=10m
SIMULATOR_HTTP_ADDR=:8090
SIMULATOR_INTERVAL=250ms
MARKET_WS_URL=ws://market-simulator:8090/ws
MARKET_MAX_MESSAGE_BYTES=1048576
MARKET_MAX_RECONNECTS=5
MARKET_INITIAL_BACKOFF=250ms
MARKET_MAX_BACKOFF=5s
MARKET_HEARTBEAT_INTERVAL=10s
MARKET_OPERATION_TIMEOUT=2s
CANDLE_HTTP_ADDR=:8091
CANDLE_PRICE_SCALE=2
CANDLE_QUANTITY_SCALE=3
CANDLE_OPERATION_TIMEOUT=2s
FUNDING_INTERVAL=8h
OPENAI_MODEL=gpt-5-mini
# Optional: when empty, the audited deterministic local risk explainer is used.
OPENAI_API_KEY=
